PORT=5000
CLIENT_URL=http://localhost:5173
PUBLIC_SERVER_URL=http://localhost:5000
# Resumable uploads use 4 MB chunks on persistent disk (default maximum: 2 GB/file).
MAX_UPLOAD_MB=2048
# Production without SMS costs: set AUTH_MODE=google and your Google OAuth Web client ID.
# Verify Google login on the backend. This DOES NOT verify phone ownership.
# Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client IDs (Web).
# Add authorized JavaScript origins: https://sitfounder.netlify.app and your localhost origin.
# NODE_ENV=production
AUTH_MODE=google
GOOGLE_CLIENT_ID=863227368202-n9cfhf7fs8pqtjl2knhmd6k8gbb5f6j5.apps.googleusercontent.com
# To keep optional paid phone/SMS login instead use AUTH_MODE=sms.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
PHONE_COUNTRY_CODE=+91
# Set the actual founder number.
FOUNDER_PHONE=
FOUNDER_NAME=Site founder
VAPID_SUBJECT=mailto:admin@example.com
# Optional. Without Cloudinary, files use DATA_DIR/uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Use persistent storage on a hosted server.
# DATA_DIR=./data

# Optional AI avatar generation/editing (requires provider billing). Keep the API key server-side.
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1
