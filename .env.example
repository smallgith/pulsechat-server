PORT=5000
CLIENT_URL=http://localhost:5173
PUBLIC_SERVER_URL=http://localhost:5000
# Resumable uploads use 4 MB chunks on persistent disk (default maximum: 2 GB/file).
MAX_UPLOAD_MB=2048
# Google is the only identity provider. Add your site's HTTPS origin in Google Cloud Console.
GOOGLE_CLIENT_ID=863227368202-n9cfhf7fs8pqtjl2knhmd6k8gbb5f6j5.apps.googleusercontent.com
# Rolling login duration (minimum 31 days; refreshed by authenticated activity).
SESSION_DAYS=35
# Production: PUBLIC_SERVER_URL must be https://YOUR-SERVICE.onrender.com
# On Render, attach a persistent disk and set DATA_DIR to a directory on that disk.
# DATA_DIR=/var/data/pulsechat
# Optional founder role: this verified Google email becomes the founder account.
FOUNDER_EMAIL=
# Legacy founder contact/account ID, retained for already-linked accounts.
FOUNDER_PHONE=
FOUNDER_NAME=Site founder
VAPID_SUBJECT=mailto:admin@example.com
# Optional. Without Cloudinary, files use DATA_DIR/uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Use persistent storage on a hosted server.
# DATA_DIR=./data

# Optional AI avatar generation/editing (requires provider billing). Keep the API key server-side.
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1
