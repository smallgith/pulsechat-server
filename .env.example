PORT=5000
CLIENT_URL=http://localhost:5173
PUBLIC_SERVER_URL=http://localhost:5000
# Resumable uploads use 4 MB chunks on persistent disk (default maximum: 2 GB/file).
MAX_UPLOAD_MB=2048
# Demo login displays 111111 explicitly. Use sms and configure Twilio for real OTPs.
AUTH_MODE=demo
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
PHONE_COUNTRY_CODE=+91
# Set the actual founder number.
FOUNDER_PHONE=
FOUNDER_NAME=Site founder
VAPID_SUBJECT=mailto:sitfounder.netlify.app
# Optional. Without Cloudinary, files use DATA_DIR/uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Use persistent storage on a hosted server.
# DATA_DIR=./data
